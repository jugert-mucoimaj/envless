# Copy to .env before running docker compose.
#
# Encrypts every value envless stores. There is no default on purpose - a key
# committed to a repository is a key every deployment shares. Generate one:
#
#   docker run --rm python:3.12-alpine sh -c \
#     "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#
# Keep it somewhere safe. Values written under one key cannot be read under
# another, and envless will not re-encrypt them for you.
ENVLESS_MASTER_KEY=

# Postgres password for the database compose brings up. Fine as-is on a laptop;
# change it if the port is reachable from anywhere but this machine.
POSTGRES_PASSWORD=kali

# Where the browser should look for the API. It is compiled into the command
# centre's bundle at build time, so it must be an address your browser can
# reach, and changing it means rebuilding the image.
NEXT_PUBLIC_ENVLESS_API=http://127.0.0.1:8000

# Published ports. Postgres avoids 5432 by default so it does not collide with
# one already installed on the host.
CENTRE_PORT=3000
API_PORT=8000
PIGEON_PORT=8100
POSTGRES_PORT=5433
