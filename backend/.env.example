# Copy to .env and fill in.
# Postgres connection for the envless control-plane database.
DATABASE_URL=postgresql+psycopg://postgres:kali@localhost:5432/envless

# Fernet key used to encrypt variable values at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVLESS_MASTER_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8100

# Reads a token may make in a minute before it is refused with a 429.
RUNTIME_RATE_LIMIT=120

# Reads a token may make in a minute before it is flagged as a burst. An
# application is told when its configuration changes, so it should be well
# under this.
RUNTIME_BURST_ALERT=30

# Believe X-Forwarded-For. Leave this off unless something in front of envless
# is known to be rewriting it - otherwise a caller can name its own address and
# walk past the unfamiliar-source check.
TRUST_PROXY_HEADER=false
